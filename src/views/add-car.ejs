<%- include('partials/header') %>

<section class="featured">
    <div style="
        max-width: 600px;
        margin: 0 auto;
        background-color: rgb(10, 9, 9);
        padding: 2.5rem;
        border-radius: 12px;
        box-shadow: none;
        border: wheat solid 1px;
        ">
        <h2 style="margin-bottom: 1.5rem; text-align: center;">Add a New Car</h2>
    
    <form action="/cars" method="post" style="display: flex; flex-direction: column; gap: 1.5rem;">

        <div>
            <label for="title" style="font-weight: 300; margin-bottom: 1rem;">Title:</label>

            <input
             type="text"
             id="title"
             name="title"
             required>
        </div>

        <div class="year">
            <label for="year">Year:</label>
            <input
            type="number"
            id="year"
            name="year"
            required>
        </div>

        <div class="description">
            <label for="description">Description:</label>
            <input
            type="text"
            id="description"
            name="description"
            required>
        </div>

        <div>
            <label for="image_url">Image URL:</label>
            <input
            type="text"
            id="image_url"
            name="image_url"
            placeholder="https://...">
        </div>

        <button type="submit" class="btn-primary">Add Car</button>
    </form></div>
</section>

<%- include('partials/footer') %>