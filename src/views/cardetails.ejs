<%- include('partials/header') %>
<main>
  <div class="car-details">
    <h1><%= car.title %></h1>
    <img class="image" src="<%= car.image_url %>" alt="<%= car.title %>">
    <div class="details">
      <p><strong>Year:</strong> <%= car.year %></p>
      <p><strong>Description:</strong> <%= car.description %></p>
      <a href="/" class="btn">Back to Cars</a>
    </div>
  </div>
</main>

<% if (car.image_url) { %>
  <div style="
    background-image: url('<%= car.image_url %>');
    background-size: cover;
    background-position: center;
    width: 100%;
    height: 300px;"
>
  <img
    src="<%= car.image_url %>"
    alt="<%= car.title %>"
    style="display: none;"
    >
  </div>

  <% } else { %>
  <div
    class="plaveholder-img"
    style="
    background-color: #ccc;
    width: 100%;
    height: 300px;"
>
</div>
<% } %>
<%- include('partials/footer') %>