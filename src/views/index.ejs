<%- include('partials/header') %>
<main>
  <h1>Cars</h1>
  <div class="car-grid">
    <% cars.forEach(car => { %>
      <div class="car-card">
        <img class="image" src="<%= car.image_url %>" alt="<%= car.title %>">
        <h3><%= car.title %></h3>
        <p><%= car.year %></p>
        <a href="/cars/<%= car.id %>" class="btn">See more</a>
      </div>
    <% }) %>
  </div>
<%- include('partials/footer') %>